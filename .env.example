# Copy to .env and fill in, then load it before running any broker-backed script:
#   set -a && source .env && set +a

# PactFlow
PACT_BROKER_BASE_URL=https://<your-tenant>.pactflow.io
PACT_BROKER_TOKEN=<a read/write API token>

# Or, for an OSS Pact Broker, swap the token for basic auth:
# PACT_BROKER_USERNAME=
# PACT_BROKER_PASSWORD=

# The environment can-i-deploy checks against and record-deployment writes to.
# Must already exist in the broker: `pact-broker create-environment --name production`
PACT_ENVIRONMENT=production

# Anonymous plugin-load telemetry is on by default.
PACT_DO_NOT_TRACK=true
